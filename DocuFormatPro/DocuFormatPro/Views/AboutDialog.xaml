<Window x:Class="DocuFormatPro.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 DocuFormat Pro"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 应用信息 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="📄" FontSize="34" HorizontalAlignment="Center"/>
            <TextBlock Text="DocuFormat Pro" FontSize="17" FontWeight="SemiBold" Foreground="#1A1A2E"
                       HorizontalAlignment="Center" Margin="0,8,0,2"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="#6C63FF" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 详情 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                Padding="14,10" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="作者：" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="weidq" FontSize="12" Foreground="#374151" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="发布日期：" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="2026-09-09" FontSize="12" Foreground="#374151"/>
                </StackPanel>
                <TextBlock Text="自动化 Word 文档排版工具：页面设置、正文与标题格式、多级标题编号、表格重塑等一站式处理。"
                           FontSize="11.5" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"/>
                <TextBlock Text="⚠ 使用中如遇 Bug，请联系作者解决。" FontSize="11.5" Foreground="#D97706"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <Button Grid.Row="2" Content="确定" Click="Close_Click"
                Height="34" Width="120" HorizontalAlignment="Center" Margin="0,16,0,0"
                Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#6C63FF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A52D5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
