<Window x:Class="DocuFormatPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DocuFormatPro.Converters"
        Title="DocuFormat Pro — 自动化 Word 排版工具"
        Width="1400" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave" DragOver="Window_DragOver" Closing="Window_Closing">

    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
        <converters:StatusToTextConverter x:Key="StatusToText"/>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CountToVisibilityConverter x:Key="CountToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Border Grid.Row="0" Background="#172033"
                CornerRadius="0,0,16,16" Padding="28,18,28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource PrimaryGradientBrush}" Margin="0,0,12,0">
                        <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DocuFormat Pro" FontSize="19" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="自动化 Word 排版工具" FontSize="10.5" Foreground="#9CA3AF" FontFamily="Microsoft YaHei UI" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource BadgeStyle}">
                        <TextBlock Text="📐 页边距" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>
                    <Border Style="{StaticResource BadgeStyle}">
                        <TextBlock Text="🔤 字体分离" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>
                    <Border Style="{StaticResource BadgeStyle}">
                        <TextBlock Text="📊 表格重塑" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="当前规则" FontSize="10" Foreground="#8290A5" FontFamily="Microsoft YaHei UI"/>
                        <TextBlock Text="{Binding CurrentRule.RuleName}" FontSize="13" Foreground="White" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="待处理文件" FontSize="10" Foreground="#8290A5" FontFamily="Microsoft YaHei UI"/>
                        <TextBlock Text="{Binding FileItems.Count}" FontSize="13" Foreground="White" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Background="#243149" CornerRadius="7" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#2DD4BF" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="工作台就绪" FontSize="11" Foreground="#D8E2EF" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== MAIN: LEFT RULES + RIGHT FILES ========== -->
        <Grid Grid.Row="1" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- WORKFLOW NAVIGATION -->
            <Border Grid.Column="0" Background="#172033" CornerRadius="12" Margin="0,0,14,0" Padding="14,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="工作流" FontSize="11" Foreground="#7F8DA3" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                        <TextBlock Text="排版控制台" FontSize="16" Foreground="White" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <Border Background="#2A3953" CornerRadius="7" Padding="10,11" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="01" FontSize="10" Foreground="#2DD4BF" FontWeight="Bold" FontFamily="Segoe UI" Width="28"/>
                                <TextBlock Text="排版规则" FontSize="12" Foreground="White" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="10,11" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="02" FontSize="10" Foreground="#71819A" FontWeight="Bold" FontFamily="Segoe UI" Width="28"/>
                                <TextBlock Text="文件队列" FontSize="12" Foreground="#B4C0D1" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="10,11" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="03" FontSize="10" Foreground="#71819A" FontWeight="Bold" FontFamily="Segoe UI" Width="28"/>
                                <TextBlock Text="处理结果" FontSize="12" Foreground="#B4C0D1" FontFamily="Microsoft YaHei UI"/>
                            </StackPanel>
                        </Border>
                        <Separator Background="#34445E" Margin="10,10,10,12"/>
                        <TextBlock Text="页面设置" FontSize="11" Foreground="#71819A" FontFamily="Microsoft YaHei UI" Margin="10,0,0,10"/>
                        <TextBlock Text="字体与段落" FontSize="11" Foreground="#71819A" FontFamily="Microsoft YaHei UI" Margin="10,0,0,10"/>
                        <TextBlock Text="标题与编号" FontSize="11" Foreground="#71819A" FontFamily="Microsoft YaHei UI" Margin="10,0,0,10"/>
                        <TextBlock Text="表格与扩展" FontSize="11" Foreground="#71819A" FontFamily="Microsoft YaHei UI" Margin="10,0,0,10"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#223049" CornerRadius="8" Padding="10,11">
                        <StackPanel>
                            <TextBlock Text="处理提示" FontSize="10" Foreground="#7F8DA3" FontFamily="Microsoft YaHei UI"/>
                            <TextBlock Text="拖入 Word 文件后开始配置" FontSize="11" Foreground="#D7E0ED" TextWrapping="Wrap" FontFamily="Microsoft YaHei UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- LEFT: RULES PANEL -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="0,0,16,0" Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#1A1A2E" Opacity="0.05"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- PANEL TITLE -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="排版规则" FontSize="18" FontWeight="SemiBold" Foreground="#172033" FontFamily="Microsoft YaHei UI"/>
                                    <TextBlock Text="页面、正文、标题、表格与扩展处理" FontSize="11" Foreground="#7C8798" FontFamily="Microsoft YaHei UI" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#2DD4BF" CornerRadius="6" Padding="9,6" VerticalAlignment="Center">
                                    <TextBlock Text="规则" FontSize="10" FontWeight="SemiBold" Foreground="#102027" FontFamily="Microsoft YaHei UI"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="📐" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="排版规则" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A2E" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- PAGE MARGINS -->
                        <Border Style="{StaticResource RuleGroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="页面设置" Style="{StaticResource RuleGroupTitleStyle}"/>
                                <CheckBox Content="应用页面设置" IsChecked="{Binding CurrentRule.ApplyPageMargins}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <StackPanel IsEnabled="{Binding CurrentRule.ApplyPageMargins}">
                                <UniformGrid Columns="2" Margin="0,0,0,0">
                                    <StackPanel Margin="0,0,4,4">
                                        <TextBlock Text="上边距 (cm)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CurrentRule.PageMargins.TopMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,4">
                                        <TextBlock Text="下边距 (cm)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CurrentRule.PageMargins.BottomMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="左边距 (cm)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CurrentRule.PageMargins.LeftMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="右边距 (cm)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CurrentRule.PageMargins.RightMargin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BODY TEXT -->
                        <Border Style="{StaticResource RuleGroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="正文格式" Style="{StaticResource RuleGroupTitleStyle}"/>
                                <CheckBox Content="应用正文格式" IsChecked="{Binding CurrentRule.ApplyBodyFormatting}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <StackPanel IsEnabled="{Binding CurrentRule.ApplyBodyFormatting}">
                                <TextBlock Text="中文字体" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding ChineseFontNames}" SelectedItem="{Binding CurrentRule.BodyText.ChineseFontName}" Style="{StaticResource RuleComboBoxStyle}" IsEditable="True" Margin="0,0,0,6"/>
                                <TextBlock Text="英文字体" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding EnglishFontNames}" SelectedItem="{Binding CurrentRule.BodyText.EnglishFontName}" Style="{StaticResource RuleComboBoxStyle}" IsEditable="True" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="字号" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding FontSizeNames}" SelectedItem="{Binding CurrentRule.BodyText.FontSizeName}" Style="{StaticResource RuleComboBoxStyle}" SelectionChanged="BodyFontSize_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="磅值" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CurrentRule.BodyText.FontSizePoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Content="加粗" IsChecked="{Binding CurrentRule.BodyText.IsBold}" Style="{StaticResource RuleCheckBoxStyle}" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox Content="设置字体颜色" IsChecked="{Binding CurrentRule.BodyText.UseCustomFontColor}" Style="{StaticResource RuleCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding CurrentRule.BodyText.FontColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Width="80" Margin="8,0,0,0" IsEnabled="{Binding CurrentRule.BodyText.UseCustomFontColor}" VerticalAlignment="Center"/>
                                </StackPanel>
                                </StackPanel>
                                <Separator Background="#E5E7EB" Margin="0,8,0,6"/>
                                <CheckBox Content="规范化文本（去除中英文空格、英文标点转中文）" IsChecked="{Binding CurrentRule.NormalizeBodyText}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <CheckBox Content="清除文字高亮和底纹背景色" IsChecked="{Binding CurrentRule.ClearTextBackground}" Style="{StaticResource RuleCheckBoxStyle}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- PARAGRAPH -->
                        <Border Style="{StaticResource RuleGroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="段落格式" Style="{StaticResource RuleGroupTitleStyle}"/>
                                <CheckBox Content="应用正文格式" IsChecked="{Binding CurrentRule.ApplyBodyFormatting}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <StackPanel IsEnabled="{Binding CurrentRule.ApplyBodyFormatting}">
                                <TextBlock Text="首行缩进 (字符)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding CurrentRule.Paragraph.FirstLineIndentChars, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,4,6">
                                        <TextBlock Text="行距类型" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding LineSpacingTypes}" Style="{StaticResource RuleComboBoxStyle}" SelectedIndex="1" SelectionChanged="BodyLineSpacingType_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,6">
                                        <TextBlock Text="行距值" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding CurrentRule.Paragraph.LineSpacingValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Visibility="{Binding CurrentRule.Paragraph.HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,6">
                                        <TextBlock Text="单位" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentRule.Paragraph.LineSpacingValueUnitText}" VerticalAlignment="Center" Foreground="#6B7280" Visibility="{Binding CurrentRule.Paragraph.HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="正文对齐方式" FontSize="10.5" Foreground="#9CA3AF" Margin="0,6,0,3"/>
                                <ComboBox ItemsSource="{Binding AlignmentTypes}" SelectedIndex="{Binding CurrentRule.Paragraph.AlignmentIndex}" Style="{StaticResource RuleComboBoxStyle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="段前 (行)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <StackPanel Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Paragraph.SpaceBeforeLines, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Width="70"/><TextBlock Text="行" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="段后 (行)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <StackPanel Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Paragraph.SpaceAfterLines, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Width="70"/><TextBlock Text="行" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    </StackPanel>
                                </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- HEADINGS -->
                        <Border Style="{StaticResource RuleGroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="标题格式" Style="{StaticResource RuleGroupTitleStyle}"/>
                                <CheckBox Content="应用标题样式" IsChecked="{Binding CurrentRule.ApplyHeadingFormatting}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <StackPanel IsEnabled="{Binding CurrentRule.ApplyHeadingFormatting}">
                                <!-- 列标题 -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="中文字体" FontSize="10" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="3" Text="字号" FontSize="10" Foreground="#9CA3AF"/>
                                </Grid>
                                <!-- 标题 1 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题 1" FontSize="11.5" Foreground="#374151" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding HeadingChineseFontNames}"
                                              SelectedItem="{Binding CurrentRule.Headings[0].ChineseFontName}"
                                              Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding FontSizeNames}"
                                              SelectedItem="{Binding CurrentRule.Headings[0].FontSizeName}"
                                              Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11"
                                              Tag="1" SelectionChanged="HeadingFontSize_Changed"/>
                                </Grid>
                                <!-- 标题 2 -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题 2" FontSize="11.5" Foreground="#374151" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding HeadingChineseFontNames}"
                                              SelectedItem="{Binding CurrentRule.Headings[1].ChineseFontName}"
                                              Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding FontSizeNames}"
                                              SelectedItem="{Binding CurrentRule.Headings[1].FontSizeName}"
                                              Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11"
                                              Tag="2" SelectionChanged="HeadingFontSize_Changed"/>
                                </Grid>
                                <!-- 标题 3 -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题 3" FontSize="11.5" Foreground="#374151" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding HeadingChineseFontNames}"
                                              SelectedItem="{Binding CurrentRule.Headings[2].ChineseFontName}"
                                              Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding FontSizeNames}"
                                              SelectedItem="{Binding CurrentRule.Headings[2].FontSizeName}"
                                              Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11"
                                              Tag="3" SelectionChanged="HeadingFontSize_Changed"/>
                                </Grid>
                                <Separator Background="#E5E7EB" Margin="0,8,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="段前pt" FontSize="9.5" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="2" Text="段后pt" FontSize="9.5" Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="3" Text="行距" FontSize="9.5" Foreground="#9CA3AF" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="值" FontSize="9.5" Foreground="#9CA3AF" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="5" Text="单位" FontSize="9.5" Foreground="#9CA3AF" Margin="4,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题 1" FontSize="11" Foreground="#374151" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Headings[0].SpaceBeforePointsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource RuleTextBoxStyle}" Height="26" Width="38" FontSize="11"/><TextBlock Text="pt" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Headings[0].SpaceAfterPointsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource RuleTextBoxStyle}" Height="26" Width="38" FontSize="11"/><TextBlock Text="pt" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding LineSpacingTypes}" Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11" SelectedIndex="1" Tag="1" SelectionChanged="HeadingLineSpacingType_Changed" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding CurrentRule.Headings[0].LineSpacingValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Height="26" FontSize="11" Visibility="{Binding CurrentRule.Headings[0].HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding CurrentRule.Headings[0].LineSpacingValueUnitText}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#6B7280" Visibility="{Binding CurrentRule.Headings[0].HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题 2" FontSize="11" Foreground="#374151" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Headings[1].SpaceBeforePointsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource RuleTextBoxStyle}" Height="26" Width="38" FontSize="11"/><TextBlock Text="pt" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Headings[1].SpaceAfterPointsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource RuleTextBoxStyle}" Height="26" Width="38" FontSize="11"/><TextBlock Text="pt" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding LineSpacingTypes}" Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11" SelectedIndex="1" Tag="2" SelectionChanged="HeadingLineSpacingType_Changed" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding CurrentRule.Headings[1].LineSpacingValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Height="26" FontSize="11" Visibility="{Binding CurrentRule.Headings[1].HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding CurrentRule.Headings[1].LineSpacingValueUnitText}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#6B7280" Visibility="{Binding CurrentRule.Headings[1].HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题 3" FontSize="11" Foreground="#374151" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Headings[2].SpaceBeforePointsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource RuleTextBoxStyle}" Height="26" Width="38" FontSize="11"/><TextBlock Text="pt" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBox Text="{Binding CurrentRule.Headings[2].SpaceAfterPointsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource RuleTextBoxStyle}" Height="26" Width="38" FontSize="11"/><TextBlock Text="pt" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#6B7280"/></StackPanel>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding LineSpacingTypes}" Style="{StaticResource RuleComboBoxStyle}" Height="26" FontSize="11" SelectedIndex="1" Tag="3" SelectionChanged="HeadingLineSpacingType_Changed" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding CurrentRule.Headings[2].LineSpacingValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Height="26" FontSize="11" Visibility="{Binding CurrentRule.Headings[2].HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding CurrentRule.Headings[2].LineSpacingValueUnitText}" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#6B7280" Visibility="{Binding CurrentRule.Headings[2].HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <TextBlock Text="英文标题字体固定 Times New Roman" FontSize="9.5" Foreground="#9CA3AF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2" Margin="0,2,0,0">
                                    <StackPanel Margin="0,0,4,4">
                                        <TextBlock Text="标题1对齐" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding AlignmentTypes}" SelectedIndex="{Binding CurrentRule.Headings[0].AlignmentIndex}" Style="{StaticResource RuleComboBoxStyle}" Tag="1" SelectionChanged="HeadingAlignment_Changed"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,4">
                                        <TextBlock Text="标题2对齐" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding AlignmentTypes}" SelectedIndex="{Binding CurrentRule.Headings[1].AlignmentIndex}" Style="{StaticResource RuleComboBoxStyle}" Tag="2" SelectionChanged="HeadingAlignment_Changed"/>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="标题3对齐" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding AlignmentTypes}" SelectedIndex="{Binding CurrentRule.Headings[2].AlignmentIndex}" Style="{StaticResource RuleComboBoxStyle}" Tag="3" SelectionChanged="HeadingAlignment_Changed"/>
                                </StackPanel>
                                </StackPanel>
                                <!-- 标题自动编号 -->
                                <Separator Background="#E5E7EB" Margin="0,8,0,6"/>
                                <CheckBox Content="启用标题自动编号" IsChecked="{Binding CurrentRule.HeadingNumbering.EnableNumbering}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <StackPanel IsEnabled="{Binding CurrentRule.HeadingNumbering.EnableNumbering}">
                                    <CheckBox Content="去除现有编号前缀后重新编号" IsChecked="{Binding CurrentRule.HeadingNumbering.StripExistingNumbers}" Style="{StaticResource RuleCheckBoxStyle}" Margin="0,2,0,4"/>
                                    <TextBlock Text="编号方案" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding HeadingNumberingSchemes}"
                                              Style="{StaticResource RuleComboBoxStyle}"
                                              SelectedIndex="{Binding CurrentRule.HeadingNumbering.SchemeIndex}"
                                              SelectionChanged="HeadingNumberingScheme_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TABLE -->
                        <Border Style="{StaticResource RuleGroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="表格格式" Style="{StaticResource RuleGroupTitleStyle}"/>
                                <CheckBox Content="应用表格样式" IsChecked="{Binding CurrentRule.Table.ApplyTableFormatting}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <CheckBox Content="自动处理题注编号" IsChecked="{Binding CurrentRule.Table.ApplyTableCaptions}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <StackPanel IsEnabled="{Binding CurrentRule.Table.ApplyTableFormatting}">
                                    <!-- 字体字号 -->
                                    <TextBlock Text="中文字体" FontSize="10.5" Foreground="#9CA3AF" Margin="0,6,0,3"/>
                                    <ComboBox ItemsSource="{Binding ChineseFontNames}" SelectedItem="{Binding CurrentRule.Table.ChineseFontName}" Style="{StaticResource RuleComboBoxStyle}" IsEditable="True"/>
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="字号" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                            <ComboBox ItemsSource="{Binding FontSizeNames}" SelectedItem="{Binding CurrentRule.Table.FontSizeName}" Style="{StaticResource RuleComboBoxStyle}" SelectionChanged="TableFontSize_Changed"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="磅值" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding CurrentRule.Table.FontSizePoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <!-- 首行底色 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <CheckBox Content="首行底色" IsChecked="{Binding CurrentRule.Table.UseHeaderShading}" Style="{StaticResource RuleCheckBoxStyle}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CurrentRule.Table.HeaderShadingColorHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Width="75" Margin="8,0,0,0" IsEnabled="{Binding CurrentRule.Table.UseHeaderShading}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- 固定默认项 -->
                                    <CheckBox Content="表头加粗" IsChecked="{Binding CurrentRule.Table.HeaderBold}" Style="{StaticResource RuleCheckBoxStyle}" IsEnabled="False" Margin="0,4,0,0"/>
                                    <CheckBox Content="跨页重复表头" IsChecked="{Binding CurrentRule.Table.RepeatHeaderRow}" Style="{StaticResource RuleCheckBoxStyle}" IsEnabled="False"/>
                                    <UniformGrid Columns="2" Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="行距值 (磅)" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding CurrentRule.Table.LineSpacingValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RuleTextBoxStyle}" Visibility="{Binding CurrentRule.Table.HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="单位" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentRule.Table.LineSpacingValueUnitText}" VerticalAlignment="Center" Foreground="#6B7280" Visibility="{Binding CurrentRule.Table.HasLineSpacingValue, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="边框" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                            <TextBox Text="黑色单细线" Style="{StaticResource RuleTextBoxStyle}" IsReadOnly="True"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- FRONT MATTER -->
                        <Border Style="{StaticResource RuleGroupCardStyle}">
                            <StackPanel>
                                <TextBlock Text="封面与前置页" Style="{StaticResource RuleGroupTitleStyle}"/>
                                <CheckBox Content="启用前置页插入 (复制模板的前4页)" IsChecked="{Binding CurrentRule.FrontMatter.InsertFrontMatter}" Style="{StaticResource RuleCheckBoxStyle}"/>
                                <StackPanel IsEnabled="{Binding CurrentRule.FrontMatter.InsertFrontMatter}">
                                    <TextBlock Text="前置页模板路径" FontSize="10.5" Foreground="#9CA3AF" Margin="0,4,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CurrentRule.FrontMatter.TemplateFilePath}" Style="{StaticResource RuleTextBoxStyle}" IsReadOnly="True" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="浏览..." Style="{StaticResource SmallOutlineButtonStyle}" Command="{Binding SelectFrontMatterTemplateCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TEMPLATE ACTIONS -->
                        <Border Style="{StaticResource RuleGroupCardStyle}" IsEnabled="False" Opacity="0.5">
                            <StackPanel>
                                <TextBlock Text="模板管理（暂未开放）" Style="{StaticResource RuleGroupTitleStyle}"/>
                                <Button Content="📥 从文档提取模板" Style="{StaticResource SmallPrimaryButtonStyle}" Background="#6C63FF" Command="{Binding ImportTemplateCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button Content="💾 保存模板" Style="{StaticResource SmallOutlineButtonStyle}" Command="{Binding SaveRuleCommand}" Margin="0,0,4,0"/>
                                    <Button Content="🔄 恢复默认" Style="{StaticResource SmallOutlineButtonStyle}" Command="{Binding ResetToDefaultCommand}" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <TextBlock Text="已保存模板" FontSize="10.5" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding SavedRuleNames}" SelectedItem="{Binding SelectedSavedRuleName}" Style="{StaticResource RuleComboBoxStyle}" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2">
                                    <Button Content="📂 加载" Style="{StaticResource SmallOutlineButtonStyle}" Command="{Binding LoadRuleCommand}" Margin="0,0,4,0"/>
                                    <Button Content="🗑 删除" Style="{StaticResource SmallOutlineButtonStyle}" Foreground="#F44336" BorderBrush="#F44336" Command="{Binding DeleteRuleCommand}" Margin="4,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: FILES AREA -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dropzone -->
                <Border x:Name="DropZone" Grid.Row="0" CornerRadius="14" MinHeight="140"
                        Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                        Visibility="{Binding FileItems.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}">
                    <Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush x:Name="DropZoneBorderBrush" Color="#D1D5DB"/></Border.BorderBrush>
                    <Border.BorderThickness><Thickness>2</Thickness></Border.BorderThickness>
                    <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#1A1A2E" Opacity="0.04"/></Border.Effect>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Margin="0,0,0,10" HorizontalAlignment="Center">
                            <Border.Background><SolidColorBrush Color="#6C63FF" Opacity="0.08"/></Border.Background>
                            <TextBlock Text="📁" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="拖拽 Word 文档到此处" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A2E" HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                        <TextBlock Text="或点击此区域选择文件  ·  支持 .doc / .docx" FontSize="11.5" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Microsoft YaHei UI"/>
                    </StackPanel>
                </Border>

                <!-- Drop overlay -->
                <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2" CornerRadius="14" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="100">
                    <Border.Background><SolidColorBrush Color="#6C63FF" Opacity="0.06"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#6C63FF" Opacity="0.5"/></Border.BorderBrush>
                    <Border.BorderThickness><Thickness>2.5</Thickness></Border.BorderThickness>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="松开鼠标以添加文件" FontSize="15" FontWeight="SemiBold" Foreground="#6C63FF" HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                    </StackPanel>
                </Border>

                <!-- File list -->
                <Grid Grid.Row="1" Visibility="{Binding FileItems.Count, Converter={StaticResource CountToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#1A1A2E" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center">
                                <Run Text="待处理文件 ("/>
                                <Run Text="{Binding FileItems.Count, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ 添加文件" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11.5" Command="{Binding AddFilesCommand}"/>
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{Binding FileItems}" SelectedItem="{Binding SelectedFileItem, Mode=TwoWay}" Style="{StaticResource FileListViewStyle}" ItemContainerStyle="{StaticResource FileListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border.Background><SolidColorBrush Color="#6C63FF" Opacity="0.08"/></Border.Background>
                                        <TextBlock Text="📄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium" Foreground="#1A1A2E" FontFamily="Microsoft YaHei UI" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="#9CA3AF" FontFamily="Microsoft YaHei UI" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" FontSize="11.5" VerticalAlignment="Center" Foreground="#6B7280" FontFamily="Segoe UI" Margin="0,0,12,0"/>
                                    <Border Grid.Column="3" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0" Background="{Binding Status, Converter={StaticResource StatusToColor}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" FontSize="10.5" FontWeight="Medium" Foreground="White" FontFamily="Microsoft YaHei UI"/>
                                    </Border>
                                    <Button Grid.Column="4" Content="移除" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsNotProcessing, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========== BOTTOM PANEL ========== -->
        <Border Grid.Row="2" Background="White" CornerRadius="20,20,0,0" Padding="28,16,28,20">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="-2" Direction="90" Color="#1A1A2E" Opacity="0.06"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Style="{StaticResource ModernProgressBarStyle}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="12" Foreground="#6B7280" FontFamily="Microsoft YaHei UI" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="清空列表" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearListCommand}" Margin="0,0,10,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <Button Content="取消任务" Style="{StaticResource SecondaryButtonStyle}" Foreground="#F44336" BorderBrush="#F44336" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartProcessingCommand}" Padding="28,12" FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="开始排版" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
